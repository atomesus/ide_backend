{
  "name": "atomesus-ide-backend",
  "version": "0.1.0",
  "description": "Account, device and model-gateway backend for the Atomesus IDE",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --no-watchman --runInBand",
    "test:watch": "jest --watch --no-watchman",
    "env:check": "node scripts/check-env.js",
    "env:import": "node scripts/import-env.js",
    "db:sync": "node scripts/sync-sql.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atomesus/ide_backend.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-ses": "^3.700.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.1",
    "mysql2": "^3.15.0",
    "nodemailer": "^7.0.6",
    "rate-limit-redis": "^4.2.2",
    "redis": "^5.8.0",
    "sequelize": "^6.37.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "sqlite3": "^5.1.7",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/setupEnv.js"
    ],
    "testTimeout": 30000
  }
}
