# ============================================================================
# Atomesus IDE backend — environment
#
# Keys marked [shared] use the same names as zero_thought_node/.env so the
# values can be copied over with `npm run env:import -- ../zero_thought_node/.env`.
# Never commit .env. Generate secrets with: openssl rand -hex 32
# ============================================================================

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development                 # [shared] development | test | production
PORT=4100
# Public URL of this API (used in OAuth callback URLs and emails)
API_PUBLIC_URL=http://localhost:4100
# Website that hosts the account pages (fallback when not using /desktop/* pages here)
WEB_APP_URL=http://localhost:3000
# Reverse proxies in front of Node (see src/middleware/clientIp.js)       [shared]
TRUST_PROXY_HOPS=
# Extra CORS origins, comma separated                                        [shared]
CORS_ALLOWED_ORIGINS=
# Operators-only details on /health require this header value              [shared]
HEALTH_TOKEN=
LOG_LEVEL=info

# ---- Secrets ---------------------------------------------------------------
JWT_SECRET=change-me-64-hex                       # [shared] signs web sessions and one-time tokens
JWT_TTL=30d
SESSION_COOKIE_NAME=atomesus_session

# ---- MongoDB (login history, IDE settings, usage events) -------------------
MONGO_URI=mongodb://127.0.0.1:27017              # [shared]
MONGO_DB_NAME=atomesus_ide
MONGO_REQUIRED=true                                # [shared] false = boot without Mongo (dev only)
MONGO_POOL_MIN=5                                   # [shared]
MONGO_POOL_MAX=50                                  # [shared]
DNS_SERVERS=                                       # [shared] e.g. 8.8.8.8,1.1.1.1 for mongodb+srv on broken resolvers

# ---- SQL (users, device keys, wallets) -------------------------------------
DB_DIALECT=mysql                                   # mysql | mariadb | sqlite (tests)
DB_HOST=127.0.0.1                                  # [shared]
DB_PORT=3306                                       # [shared]
DB_USER=root                                       # [shared]
DB_PASS=                                           # [shared]
DB_NAME=atomesus_ide                               # [shared] (zero_thought uses its own DB name; keep this one separate)
DB_POOL_MIN=5                                      # [shared]
DB_POOL_MAX=20                                     # [shared]
DB_SYNC=true                                       # sequelize.sync() on boot outside production
DB_STORAGE=                                        # sqlite file path (tests use :memory:)

# ---- Redis (rate limits, OTPs, PKCE flows, device-key cache) ---------------
REDIS_URL=                                         # [shared] takes precedence over REDIS_HOST
REDIS_HOST=127.0.0.1                               # [shared]
REDIS_PORT=6379                                    # [shared]
REDIS_USERNAME=                                    # [shared]
REDIS_PASSWORD=                                    # [shared]
REDIS_TLS=false                                    # [shared]
REDIS_REQUIRED=false                               # [shared] true = refuse to boot without Redis
REDIS_KEY_PREFIX=ide:

# ---- Platform sign-in (records ARE kept for these) -------------------------
# GitHub OAuth app: callback = {API_PUBLIC_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth: callback = {API_PUBLIC_URL}/api/auth/google/callback          [shared]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Desktop deep-link schemes accepted in redirect_uri (product.json urlProtocol)
DESKTOP_REDIRECT_SCHEMES=atomesus,orbit
DEVICE_KEY_TTL_DAYS=30
DESKTOP_FLOW_TTL_SEC=600
AUTH_CODE_TTL_SEC=300
OTP_TTL_SEC=600
PASSWORD_RESET_TOKEN_TTL=15m                       # [shared]
DISPOSABLE_EMAIL_BLOCK=                            # [shared] 1 to block throwaway domains (default on in production)

# Rate limits (per 15 minutes unless stated)                                 [shared]
SIGNUP_OTP_EMAIL_MAX_PER_15MIN=3
SIGNUP_OTP_IP_MAX_PER_15MIN=5
SIGNUP_OTP_IP_MAX_PER_HOUR=10
SIGNUP_VERIFY_EMAIL_MAX_PER_15MIN=5
SIGNUP_VERIFY_IP_MAX_PER_15MIN=10
SIGNUP_VERIFY_IP_MAX_PER_HOUR=15
LOGIN_EMAIL_MAX_PER_15MIN=10
LOGIN_IP_MAX_PER_15MIN=20
PROVIDER_RELAY_IP_MAX_PER_15MIN=60
CHAT_IP_MAX_PER_MIN=120

# ---- Email (OTP, password reset) -------------------------------------------
# SES is used when AWS credentials are present; else SMTP; else OTPs are logged (dev only).
AWS_REGION=                                        # [shared]
AWS_ACCESS_KEY_ID=                                 # [shared]
AWS_SECRET_ACCESS_KEY=                             # [shared]
SES_REGION=                                        # [shared]
EMAIL_HOST=                                        # [shared]
EMAIL_PORT=465                                     # [shared]
EMAIL_USER=                                        # [shared]
EMAIL_PASS=                                        # [shared]
FROM_EMAIL=noreply@atomesus.com                    # [shared]
EMAIL_FROM_NAME=Atomesus                           # [shared]

# ---- Provider sign-in relay (NO records kept) ------------------------------
# The IDE signs users into ChatGPT (Codex), Claude, xAI and Cline with the
# provider's own OAuth. This backend only relays the token exchange and never
# stores or logs anything from it. Client ids default to the public ones the
# IDE ships; override only if you register your own.
PROVIDER_RELAY_ENABLED=true
OPENAI_CODEX_CLIENT_ID=
CLAUDE_OAUTH_CLIENT_ID=
XAI_GROK_CLIENT_ID=
PROVIDER_RELAY_TIMEOUT_MS=20000

# ---- Atomesus hosted model gateway (/api/v1/chat/completions) --------------
# OpenAI-compatible upstream (vLLM). Same keys as zero_thought_node.
ATOMESUS_BASE_URL=                                 # [shared] e.g. http://10.0.0.5:8000/v1
ATOMESUS_MODEL=ethos-6                             # [shared]
ATOMESUS_API_KEY=                                  # upstream bearer, if the gateway needs one
ATOMESUS_HOSTED_CHAT_API_KEY=                      # [shared] alias of ATOMESUS_API_KEY
ATOMESUS_MAX_CONTEXT_TOKENS=256000                 # [shared]
# JSON array overriding the model list served on /api/v1/models
ATOMESUS_MODELS=
CHAT_UPSTREAM_TIMEOUT_MS=90000
# Credits: 1 credit = 1000 tokens * multiplier
FREE_PLAN_MONTHLY_CREDITS=200
PRO_PLAN_MONTHLY_CREDITS=5000
INPUT_CREDIT_MULTIPLIER=1
OUTPUT_CREDIT_MULTIPLIER=3
