# ============================================================================
# Atomesus IDE backend — environment
#
# Accounts live in the Atomesus platform (zero_thought_node): this service reads
# its `Users` table and verifies its session JWT, so the [shared] keys must hold
# the SAME values as zero_thought_node/.env. Copy them with
#   npm run env:import -- ../zero_thought_node/.env
# Never commit .env.
# ============================================================================

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development                 # [shared] development | test | production
PORT=4100
# Public URL of this API (what the IDE's product.json orbitApiUrl points at)
API_PUBLIC_URL=http://localhost:4100                # production: https://ide-api.atomesus.com (product.json orbitApiUrl)
# The website (atomesis_frontend) that hosts /desktop/login — the IDE is sent there to sign in
WEB_APP_URL=http://localhost:3000                  # production: https://www.atomesus.com
# Reverse proxies in front of Node (see src/middleware/clientIp.js)       [shared]
TRUST_PROXY_HOPS=
# Extra CORS origins, comma separated                                        [shared]
CORS_ALLOWED_ORIGINS=
# Operators-only details on /health require this header value              [shared]
HEALTH_TOKEN=
LOG_LEVEL=info

# ---- Secrets ---------------------------------------------------------------
# MUST equal the platform's secret: website sessions ({ id, email } HS256) are verified here.
JWT_SECRET=change-me-64-hex                       # [shared]

# ---- MongoDB (login history, IDE settings, usage events) -------------------
MONGO_URI=mongodb://127.0.0.1:27017              # [shared]
MONGO_DB_NAME=atomesus_ide                         # this service's own database on that cluster
MONGO_REQUIRED=true                                # [shared] false = boot without Mongo (dev only)
MONGO_POOL_MIN=5                                   # [shared]
MONGO_POOL_MAX=50                                  # [shared]
DNS_SERVERS=                                       # [shared] e.g. 8.8.8.8,1.1.1.1 for mongodb+srv on broken resolvers

# ---- SQL: the platform database (Users is read; ide_* tables are owned here)
DB_DIALECT=mysql                                   # mysql | mariadb | sqlite (tests)
DB_HOST=127.0.0.1                                  # [shared]
DB_PORT=3306                                       # [shared]
DB_USER=root                                       # [shared]
DB_PASS=                                           # [shared]
DB_NAME=atomesusdb                                 # [shared] the database that holds the platform `Users` table
DB_POOL_MIN=5                                      # [shared]
DB_POOL_MAX=20                                     # [shared]
DB_SYNC=true                                       # create ide_* tables on boot outside production (never touches Users)
DB_STORAGE=                                        # sqlite file path (tests use :memory:)

# ---- Redis (rate limits, one-time sign-in codes, device-key cache) ---------
REDIS_URL=                                         # [shared] takes precedence over REDIS_HOST
REDIS_HOST=127.0.0.1                               # [shared]
REDIS_PORT=6379                                    # [shared]
REDIS_USERNAME=                                    # [shared]
REDIS_PASSWORD=                                    # [shared]
REDIS_TLS=false                                    # [shared]
REDIS_REQUIRED=false                               # [shared] true = refuse to boot without Redis
REDIS_KEY_PREFIX=ide:

# ---- Desktop sign-in (records ARE kept for these) --------------------------
# Deep-link schemes accepted in redirect_uri (product.json urlProtocol)
DESKTOP_REDIRECT_SCHEMES=atomesus,orbit
DEVICE_KEY_TTL_DAYS=30
AUTH_CODE_TTL_SEC=300
# Rate limits per 15 minutes
DESKTOP_APPROVE_USER_MAX_PER_15MIN=20
LOGIN_IP_MAX_PER_15MIN=20                          # [shared] (applies to the code exchange here)
PROVIDER_RELAY_IP_MAX_PER_15MIN=60
CHAT_IP_MAX_PER_MIN=120

# ---- Provider sign-in relay (NO records kept) ------------------------------
# The IDE signs users into ChatGPT (Codex), Claude, xAI and Cline with the
# provider's own OAuth. This backend only relays the token exchange and never
# stores or logs anything from it. Client ids default to the public ones the
# IDE ships; override only if you register your own.
PROVIDER_RELAY_ENABLED=true
OPENAI_CODEX_CLIENT_ID=
CLAUDE_OAUTH_CLIENT_ID=
XAI_GROK_CLIENT_ID=
PROVIDER_RELAY_TIMEOUT_MS=20000

# ---- Hosted models (/api/v1/chat/completions) -----------------------------
# Catalog: src/config/models.js. Paid plans get Ethos 6 (ethos-6), "Opus 5.5"
# (opus-5.5 -> claude-haiku-5-5) and "GPT-6.1 Sol" (gpt-6.1-sol -> gpt-6-luna);
# the IDE only ever sees the catalog ids. A model is offered only when its
# provider below is configured.
ATOMESUS_BASE_URL=                                 # [shared] Ethos on our GPUs (vLLM), e.g. http://10.0.0.5:8000/v1
ATOMESUS_MODEL=ethos-6                             # [shared]
ATOMESUS_API_KEY=                                  # upstream bearer, if the gateway needs one
ATOMESUS_HOSTED_CHAT_API_KEY=                      # [shared] alias of ATOMESUS_API_KEY
ATOMESUS_MAX_CONTEXT_TOKENS=256000                 # [shared]
ATOMESUS_MAX_OUTPUT_TOKENS=8192                    # [shared] sent as max_tokens when the IDE names no limit (gateway caps at 1024 otherwise)
CLAUDE_API_KEY=                                    # [shared] serves opus-5.5 (upstream claude-haiku-5-5)
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
OPENAI_API_KEY=                                    # [shared] serves gpt-6.1-sol (upstream gpt-6-luna)
OPENAI_BASE_URL=https://api.openai.com/v1
IDE_MODELS=                                        # JSON array to override/add catalog entries by id (name, upstreamModel, prices, disabled)
CHAT_UPSTREAM_TIMEOUT_MS=90000                     # wait for a reply to start
CHAT_STREAM_IDLE_MS=120000                         # stop a streaming reply after this much silence
CHAT_STREAM_MAX_MS=1800000                         # hard cap on one reply (30 min)

# ---- Plans and money --------------------------------------------------------
# Free accounts get nothing (no hosted models, no BYOK). Paid plans always get BYOK.
# Monthly hosted-model budget in rupees per platform planType (lowercase).
# Rs 299 at a 30% margin after 18% GST and ~2% gateway fee leaves ~Rs 172; Rs 999 leaves ~Rs 576.
IDE_PLAN_ALLOWANCES_INR=                           # e.g. {"core":172,"prime":576}
USD_INR_RATE=100                                   # rupees charged per USD of provider cost; keep above market (~95) or plans lose margin
GATEWAY_ID_SECRET=                                 # key for the opaque tool-call ids sent to the IDE (random 32+ chars)
ETHOS_MAX_CONCURRENT_PER_USER=2                    # GPU fairness: requests one user can run at once
CHAT_MAX_CONCURRENT_PER_USER=3
